{
  "paths": {
    "/medias/{mediaId}/uploadappend": {
      "post": {
        "consumes": ["application/json"],
        "parameters": [
          {
            "description": "Media ID",
            "in": "path",
            "name": "mediaId",
            "required": true,
            "type": "string",
            "x-ms-summary": "Media ID"
          },
          {
            "default": "en",
            "description": "Language",
            "in": "header",
            "name": "Accept-Language",
            "type": "string",
            "x-ms-summary": "Language"
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "chunk_id": {
                  "description": "Chunk ID",
                  "x-ms-summary": "Chunk ID",
                  "type": "string"
                },
                "segment_index": {
                  "description": "Chunk Number",
                  "x-ms-summary": "Segment number",
                  "type": "integer"
                },
                "last_chunk": {
                  "description": "Last call?",
                  "x-ms-summary": "Last Call?",
                  "type": "boolean"
                },
                "stream": {
                  "type": "object",
                  "description": "Binary Stream",
                  "properties": {
                    "filename": {
                      "type": "string"
                    },
                    "contentType": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string",
                      "format": "byte"
                    }
                  },
                  "required": ["content", "contentType", "filename"]
                }
              },
              "required": ["chunk_id", "segment_index", "stream"]
            }
          }
        ]
      }
    }
  }
}
